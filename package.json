{
  "name": "mdarai-wholesale-kiosk",
  "private": true,
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r --filter './packages/**' build && pnpm --filter @mdarai/api build && pnpm --filter @mdarai/print-agent build && pnpm --filter @mdarai/web build",
    "build:packages": "pnpm -r --filter './packages/**' build",
    "typecheck": "pnpm -r typecheck",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:e2e": "playwright test",
    "db:migrate": "pnpm --filter @mdarai/database migrate:deploy",
    "db:seed": "pnpm --filter @mdarai/database seed",
    "dev:api": "pnpm --filter @mdarai/api dev",
    "dev:web": "pnpm --filter @mdarai/web dev",
    "dev:print-agent": "pnpm --filter @mdarai/print-agent dev"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "^22.19.0",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "4.1.12"
  }
}
