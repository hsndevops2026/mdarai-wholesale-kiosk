# ---------------------------------------------------------------------------
# MdarAi Wholesale Kiosk — environment template. Copy to .env (never commit .env).
# ---------------------------------------------------------------------------

# --- API (apps/api)
NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://kiosk:kiosk@localhost:5432/kiosk
# Comma-separated browser origins allowed to call the API (the web app URL).
CORS_ORIGINS=http://localhost:3000
# Secret for hashing national IDs (HMAC-SHA256). >= 16 chars. Changing it invalidates stored IDs.
# Generate: openssl rand -base64 32
ID_HASH_PEPPER=dev-only-pepper-change-me-0000
# Shared secret between the API and the in-store print agent. Generate: openssl rand -base64 32
PRINT_AGENT_TOKEN=dev-only-print-agent-token-0000

# Kiosk sessions
KIOSK_IDLE_TIMEOUT_SECONDS=180
KIOSK_MAX_SESSION_SECONDS=1800
KIOSK_MAX_FAILED_IDENTIFY=5
STAFF_SESSION_HOURS=12

# Pricing (Israel VAT). Wholesale prices are assumed to EXCLUDE VAT by default.
VAT_RATE=0.18
PRICES_INCLUDE_VAT=false
ORDER_NUMBER_PREFIX=W
BUSINESS_TIMEZONE=Asia/Jerusalem
RATE_LIMIT_PER_MINUTE=240

# Order understanding: "rules" (offline, free) or "openai" (falls back to rules on failure).
ORDER_PARSER=rules
OPENAI_API_KEY=
# Verify the model name against your OpenAI account before enabling.
OPENAI_PARSER_MODEL=gpt-4.1-mini

# Speech-to-text: "mock" (no audio, type instead), "openai" or "elevenlabs". Paid providers need keys.
STT_PROVIDER=mock
OPENAI_STT_MODEL=gpt-4o-transcribe
ELEVENLABS_API_KEY=
ELEVENLABS_STT_MODEL=scribe_v1

# --- Seed (development only; refuses to run in production)
SEED_ADMIN_PASSWORD=admin-demo-1234
SEED_WAREHOUSE_PASSWORD=warehouse-demo-1234
SEED_KIOSK_DEVICE_TOKEN=dev-kiosk-device-token

# --- Web (apps/web)
NEXT_PUBLIC_API_URL=http://localhost:4000

# --- Print agent (services/print-agent)
API_URL=http://localhost:4000
PRINT_AGENT_ID=store-1
# simulated | network | stdout
PRINTER_MODE=simulated
PRINTER_HOST=192.168.1.50
PRINTER_PORT=9100
PRINT_OUTPUT_DIR=./print-output
POLL_INTERVAL_MS=3000
