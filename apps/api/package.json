{
  "name": "@mdarai/api",
  "version": "0.1.0",
  "private": true,
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "node dist/main.js",
    "dev": "tsc -p tsconfig.build.json --watch --preserveWatchOutput & node --watch-path=dist --enable-source-maps dist/main.js"
  },
  "dependencies": {
    "@mdarai/ai-order-parser": "workspace:*",
    "@mdarai/database": "workspace:*",
    "@mdarai/pricing-engine": "workspace:*",
    "@mdarai/product-matcher": "workspace:*",
    "@mdarai/shared-types": "workspace:*",
    "@mdarai/speech-providers": "workspace:*",
    "@nestjs/common": "11.2.7",
    "@nestjs/core": "11.2.7",
    "@nestjs/platform-express": "11.2.7",
    "@nestjs/platform-socket.io": "11.2.7",
    "@nestjs/throttler": "6.7.1",
    "@nestjs/websockets": "11.2.7",
    "csv-parse": "^6.1.0",
    "exceljs": "4.4.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "socket.io": "^4.8.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/express": "^5.0.3",
    "@types/multer": "^2.0.0"
  }
}
